# ============================================================
# pinche-backend Docker 环境变量模板
# 【用法】复制为 .env.docker 并填入真实值（.env.docker 已被 .gitignore 忽略，不提交）：
#     cp .env.docker.example .env.docker
#     docker compose up -d --build
#
# 【连接外部 MySQL / Redis（仅后端编排，DB/Redis 用外部实例）】
#   - Docker Desktop（Win/Mac）：宿主机地址用 host.docker.internal
#   - 远程服务器：填服务器实际 IP 或内网地址
#   - HOST 必须为 0.0.0.0（容器内监听所有网卡）
#   - GATEWAY_DB / CARPOOL_DB 必须为 pt_carpool（代码默认 GATEWAY_DB=silievo，不设会连错库）
#   - REDIS_URL 必填，缺失则启动直接报错
# ============================================================
PORT=14001
NODE_ENV=production
HOST=0.0.0.0

# 数据库（网关库 + 拼车库共用连接参数，仅 database 名不同）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
# 网关库：已并入 pt_carpool
GATEWAY_DB=pt_carpool
CARPOOL_DB=pt_carpool

# Redis（与网关共用实例；必填）
# 方式 A：REDIS_URL 连接串（有则优先，可直接带密码/库号，如 redis://:pass@host:6379/1）
REDIS_URL=redis://host.docker.internal:6379
# 方式 B：分字段配置（REDIS_URL 未设时生效，可单独输入密码与库号）
# REDIS_HOST=host.docker.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# 用户端 JWT
JWT_SECRET=change_me_at_least_32_chars_random
REFRESH_TOKEN_SECRET=change_me_at_least_32_chars_random_refresh
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# 管理端 JWT
ADMIN_JWT_SECRET=change_me_at_least_32_chars_random_admin
ADMIN_JWT_EXPIRES_IN=7d

# 支付宝
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
PAYMENT_DRY_RUN=true
ALIPAY_NOTIFY_URL=https://your-domain.com/api/recharge/callback

# 前端地址（线上请改为实际域名）
WEB_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# 短信服务（阿里云 SMS，4 项配置齐全时 dev/prod 都真实下发；缺失则开发环境降级打印）
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=your_sms_template_code
