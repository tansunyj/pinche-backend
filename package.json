{
  "name": "carpool-server",
  "version": "1.0.0",
  "description": "Token 拼车平台统一后端（用户端 + 管理端融合，直连网关 MySQL/Redis）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "cross-env NODE_ENV=development tsx scripts/seed.ts"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "uuid": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "cross-env": "^10.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
