# ============================================================
# SiliEvo 后端 — 生产环境模板
# ------------------------------------------------------------
# 使用方式：
#   1. 在生产服务器上复制本文件为 `backend/.env.production`
#   2. 按生产实际值填写（数据库、JWT 密钥等绝不能复用开发值）
#   3. `npm run build` 编译；`npm start` 启动 → 自动按 NODE_ENV=production 加载本文件
#
# 安全要点：
#   - JWT_SECRET、密码、AccessKey、私钥务必使用强随机值，且与 dev 不同
#   - 凭证应通过运维渠道注入，不要进 git
#   - 生产环境不会加载 .env.local（与 Next.js 行为一致），避免本地覆盖泄露到线上
# ============================================================

# ============ MySQL 数据库 ============
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=silievo
MYSQL_POOL_SIZE=20

# ============ 用户站前端地址（用于邮件中的链接，必须 HTTPS）============
WEB_BASE_URL="https://www.silievo.com"

# ============ Prisma / PostgreSQL（可选）============
# DATABASE_URL="postgresql://app_user:STRONG-PASSWORD@db.internal:5432/silievo?schema=public"

# ============ Redis（生产强烈建议加密码）============
REDIS_PASSWORD=
REDIS_URL=

# ============ JWT（务必随机 64+ 字符）============
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# ============ 服务器 ============
PORT=13001

# ============ Cloudflare Turnstile（生产必填）============
TURNSTILE_SECRET_KEY=

# ============ 微信扫码登录 ============
WECHAT_OPEN_APPID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=https://www.silievo.com/api/oauth/wechat/callback

# ============ 支付宝扫码登录 ============
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_PATH=/etc/silievo/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_REDIRECT_URI=https://www.silievo.com/api/oauth/alipay/callback

# ============ OAuth state CSRF 盐（生产必填，32+ 字符随机串）============
OAUTH_STATE_SECRET=

# ============ 邮件 SMTP ============
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SiliEvo
SMTP_FROM_ADDRESS=

# ============ 短信 ============
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ============ 阿里云 / 火山引擎（模型商城）============
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=codingplan

# ============ 扫码登录：微信开放平台 ============
# https://open.weixin.qq.com → 创建"网站应用" → 拿 AppID / AppSecret
WECHAT_OPEN_APPID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=https://www.silievo.com/api/oauth/wechat/callback

# ============ 扫码登录：支付宝开放平台 ============
# https://open.alipay.com → 创建"网页/移动应用" → 开通"获取会员信息(auth_user)"
ALIPAY_APP_ID=
# 应用私钥（PKCS1，单行；推荐用 _PATH 加载 PEM 文件以避免 .env 过长）
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_PATH=
# 支付宝公钥（从开放平台后台下载）
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_REDIRECT_URI=https://www.silievo.com/api/oauth/alipay/callback
# OAuth state 防 CSRF 盐（建议 32+ 字符随机串）
OAUTH_STATE_SECRET=

# ============ 支付通用配置 ============
# 线上必须 false，否则下单不真扣不真发
PAYMENT_DRY_RUN=false
# 第三方异步回调的根地址（必须公网 HTTPS）
PAYMENT_NOTIFY_BASE_URL=https://www.silievo.com
# 用户支付完成后浏览器同步跳回的前端地址
PAYMENT_RETURN_BASE_URL=https://www.silievo.com/profile?tab=billing
# 订单超时时间（分钟）
ORDER_EXPIRE_MINUTES=30
# 充值比例：1 元 = N 点
RECHARGE_POINTS_PER_YUAN=100

# ============ 支付宝支付（复用上面的 ALIPAY_APP_ID / 私钥 / 公钥 / GATEWAY）============
ALIPAY_NOTIFY_URL=https://www.silievo.com/api/payments/notify/alipay
ALIPAY_RETURN_URL=

# ============ 微信支付 V3 API ============
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://www.silievo.com/api/payments/notify/wechat

# ============================================================
# 多媒体创作工作室（Studio）
# ============================================================

# 线上必须 false，强制真调通义万相/可灵
MEDIA_DRY_RUN=false

# poller 配置
MEDIA_POLL_INTERVAL_MS=5000
MEDIA_JOB_TIMEOUT_MS=600000
MEDIA_POLL_BATCH_SIZE=50
MEDIA_ASSET_RECYCLE_DAYS=7

# 上传限制
MEDIA_UPLOAD_MAX_MB=20
MEDIA_UPLOAD_ACCEPT="image/png,image/jpeg,image/webp"

# ---- 阿里云 OSS（生产必填）----
STORAGE_DRY_RUN=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
# 同地域 ECS 走内网零费率
OSS_INTERNAL=true
OSS_SIGN_TTL=3600
# 生产不使用 mock 路由，留空
MOCK_OSS_URL_PREFIX=

# ---- 通义万相（复用上方 ALIYUN_API_KEY）----
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANX_DEFAULT_MODEL=wanx2.1-t2i-turbo
WANX_TIMEOUT_MS=300000

# ---- 可灵 KlingAI ----
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
KLING_TIMEOUT_MS=600000
