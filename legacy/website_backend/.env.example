# Silievo Website Backend 环境变量

# 服务器配置
PORT=13001
NODE_ENV=production

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/silievo?schema=public
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=silievo

# Redis 配置
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# 日志级别配置
# 可选值: debug < info < warn < error < silent
# debug: 输出所有日志（包括调试信息）
# info:  输出普通信息及以上级别（默认）
# warn:  仅输出警告和错误
# error: 仅输出错误
# silent: 不输出任何日志
LOG_LEVEL=info

# 支付宝支付配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_APP_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 微信支付配置
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_API_KEY=your_api_key

# 阿里云 OSS 配置
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_access_secret
OSS_BUCKET=your-bucket-name

# 阿里云百炼配置
BAILIAN_API_KEY=your_bailian_api_key

# Agent 系统配置
AGENT_MOCK_MODE=false
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# 可选：开发模式配置
# PAYMENT_DRY_RUN=true
# STORAGE_DRY_RUN=true

# ================================================
# VolcTokens 火山引擎 Seedance 视频生成配置
# ================================================
VOLCTOKENS_API_KEY=sk-your_volctokens_api_key_here
VOLCTOKENS_BASE_URL=https://volctokens.api.mengfactory.cn
VOLCTOKENS_TIMEOUT_MS=300000
