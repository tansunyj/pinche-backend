# ============================================================
# SiliEvo 后端 — 开发环境模板
# ------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 `backend/.env.development`（被 .gitignore 忽略）
#   2. 按本机情况填值
#   3. 通过 `npm run dev` 启动 → 自动按 NODE_ENV=development 加载本文件
#
# 加载优先级（高 → 低，已存在的不会被覆盖）：
#   .env.development.local > .env.development > .env.local > .env
# ============================================================

# ============ MySQL 数据库 ============
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="123456"
MYSQL_DATABASE="silievo"
MYSQL_POOL_SIZE="10"

# ============ 用户站前端地址（用于邮件中的链接）============
WEB_BASE_URL="http://localhost:13000"

# ============ Prisma / PostgreSQL（可选 - 仅供旧接口）============
# DATABASE_URL="postgresql://app_user:change-this-db-password@localhost:5432/silievo?schema=public"

# ============ Redis ============
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ============ JWT ============
JWT_SECRET="dev-only-replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ============ 服务器 ============
PORT=13001
# NODE_ENV 由 npm script `cross-env` 注入，无需在文件里再写

# ============ Cloudflare Turnstile（留空跳过）============
TURNSTILE_SECRET_KEY=

# ============ 微信扫码登录（留空则禁用）============
WECHAT_OPEN_APPID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://localhost:13001/api/oauth/wechat/callback

# ============ 支付宝扫码登录（留空则禁用）============
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_REDIRECT_URI=http://localhost:13001/api/oauth/alipay/callback

# ============ OAuth state CSRF 盐（开发用任意值即可）============
OAUTH_STATE_SECRET=dev-csrf-secret

# ============ 邮件 SMTP（留空降级到 console）============
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SiliEvo
SMTP_FROM_ADDRESS=

# ============ 短信（留空降级到 dev 日志）============
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ============ 阿里云 / 火山引擎（模型商城）============
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=codingplan

# ============ 扫码登录：微信开放平台（留空 → 后端登录回调 503，前端弹窗不渲染微信按钮）============
WECHAT_OPEN_APPID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://localhost:13001/api/oauth/wechat/callback

# ============ 扫码登录：支付宝开放平台 ============
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_REDIRECT_URI=http://localhost:13001/api/oauth/alipay/callback
OAUTH_STATE_SECRET=dev-csrf-secret

# ============ 支付通用（PAYMENT_DRY_RUN=true 时不真调第三方，下单返回 mock）============
PAYMENT_DRY_RUN=true
PAYMENT_NOTIFY_BASE_URL=http://localhost:13001
PAYMENT_RETURN_BASE_URL=http://localhost:13000/profile?tab=billing
ORDER_EXPIRE_MINUTES=30
RECHARGE_POINTS_PER_YUAN=100

# ============ 支付宝支付（复用上面 ALIPAY_APP_ID / 私钥 / 公钥 / GATEWAY）============
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# ============ 微信支付 V3 API ============
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=

# ============================================================
# 多媒体创作工作室（Studio：文生图 / 图生图 / 文生视频 / 图生视频 / 首尾帧）
# ============================================================

# ---- 总开关 ----
# MEDIA_DRY_RUN=true 时所有 Provider 调用强制走 MockProvider，
# 不依赖通义万相/可灵 API Key，本地联调用
MEDIA_DRY_RUN=true

# poller 扫 running 任务的间隔（毫秒）
MEDIA_POLL_INTERVAL_MS=5000
# 单任务最长允许执行时间（毫秒），超时标记 failed 并退款
MEDIA_JOB_TIMEOUT_MS=600000
# poller 单轮最多处理多少任务（防雪崩）
MEDIA_POLL_BATCH_SIZE=20
# 软删资产保留天数，过后由 cron 物理删 OSS
MEDIA_ASSET_RECYCLE_DAYS=7

# 单次上传文件最大尺寸（MB）
MEDIA_UPLOAD_MAX_MB=20
# 允许的上传 MIME 列表（逗号分隔）
MEDIA_UPLOAD_ACCEPT="image/png,image/jpeg,image/webp"

# ---- OSS 存储 ----
# STORAGE_DRY_RUN=true 或下方凭证为空时，自动落本地 ./tmp/oss-mock/
STORAGE_DRY_RUN=true

# 阿里云 OSS 凭证（生产必填）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
# 内网走零费率（同地域 ECS / 函数计算时设 true）
OSS_INTERNAL=false
# 签名 URL 默认过期时间（秒）
OSS_SIGN_TTL=3600

# dry-run 模式下伪签名 URL 的前缀，对应 backend 自挂的 /mock-oss/* 路由
MOCK_OSS_URL_PREFIX=http://localhost:13001/mock-oss

# ---- 通义万相（文生图 / 图生图）凭证 ----
# 注意：现在通过 relay server 的内部接口调用，不再直接调用 DashScope
# 需要配置 RELAY_SERVER_URL 和 RELAY_INTERNAL_JWT
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANX_DEFAULT_MODEL=wanx2.1-t2i-turbo
WANX_TIMEOUT_MS=300000

# ---- Relay Server 内部接口配置 ----
# silievo-site 后端调用 relay server 内部接口（如图片/视频生成）时使用
# RELAY_SERVER_URL - relay server 地址（如 http://localhost:3001）
RELAY_SERVER_URL=http://localhost:3001
# RELAY_INTERNAL_JWT - 用于调用内部接口的 JWT Token
# 生成方式：npm run generate:relay-jwt 或在 silievo-site 项目根目录运行：
#   npx tsx backend/scripts/generate-relay-jwt.ts
# 确保此 token 使用与 relay server 相同的 JWT_SECRET 签发
RELAY_INTERNAL_JWT=

# ---- 可灵 KlingAI（文/图生视频、首尾帧）凭证 ----
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
KLING_TIMEOUT_MS=600000
