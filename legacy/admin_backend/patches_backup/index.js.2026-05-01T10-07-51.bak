const express = require('express');
const path = require('path');
const cors = require('cors');
const { getDb } = require('./db/init');
const authRoutes = require('./routes/auth');
const channelRoutes = require('./routes/channels');
const tokenRoutes = require('./routes/tokens');
const proxyRoutes = require('./routes/proxy');
const dashboardRoutes = require('./routes/dashboard');

const app = express();
const PORT = process.env.PORT || 3001;

app.use(cors());
app.use(express.json({ limit: '10mb' }));

app.use('/api/auth', authRoutes);
app.use('/api/channels', channelRoutes);
app.use('/api/tokens', tokenRoutes);
app.use('/api/dashboard', dashboardRoutes);
app.get('/api/prices', (req, res) => {
  const { getModelPriceList } = require('./utils/billing');
  const all = getModelPriceList();
  res.json(all);
});
app.use('/', proxyRoutes);

app.get('/api/health', (req, res) => res.json({ status: 'ok', uptime: process.uptime() }));

const webDist = path.join(__dirname, '..', 'web', 'dist');
const fs = require('fs');
if (fs.existsSync(webDist)) {
  app.use(express.static(webDist));
  app.get('*', (req, res) => {
    if (!req.path.startsWith('/v1/') && !req.path.startsWith('/api/')) {
      res.sendFile(path.join(webDist, 'index.html'));
    }
  });
}

getDb();

const server = app.listen(PORT, () => {
  console.log(`
  ═══════════════════════════════════════
    🚀 Silievo API Relay Platform
    📍 http://localhost:${PORT}
    📊 Dashboard: http://localhost:${PORT}
    🔌 API Base: http://localhost:${PORT}/v1
    👤 Default: admin / admin123
  ═══════════════════════════════════════
  `);
});

process.on('uncaughtException', (err) => {
  console.error('[Uncaught Exception]', err);
});

process.on('unhandledRejection', (reason) => {
  console.error('[Unhandled Rejection]', reason);
});

const gracefulShutdown = (signal) => {
  console.log(`[Shutdown] 收到 ${signal}，正在安全关闭…`);
  server.close(() => {
    console.log('[Shutdown] HTTP 服务器已停止接收新请求');
    try {
      const db = getDb();
      db.pragma('wal_checkpoint(TRUNCATE)');
      db.close();
      console.log('[Shutdown] 数据库已保存并关闭');
    } catch (e) {
      console.error('[Shutdown] 数据库关闭异常:', e.message);
    }
    process.exit(0);
  });
  setTimeout(() => {
    console.log('[Shutdown] 超时强制退出');
    process.exit(1);
  }, 4000);
};

process.on('SIGINT', () => gracefulShutdown('SIGINT'));
process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));

setInterval(() => {
  try {
    const db = getDb();
    db.pragma('wal_checkpoint(PASSIVE)');
  } catch (e) {
    console.error('[Checkpoint Error]', e.message);
  }
}, 60000);

const backupDir = path.join(__dirname, 'data', 'backups');
if (!fs.existsSync(backupDir)) fs.mkdirSync(backupDir, { recursive: true });

const performBackup = () => {
  try {
    const db = getDb();
    db.pragma('wal_checkpoint(TRUNCATE)');
    const dbPath = path.join(__dirname, 'data', 'silievo.db');
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    const backupPath = path.join(backupDir, `silievo-${timestamp}.db`);
    fs.copyFileSync(dbPath, backupPath);
    console.log(`[Backup] 数据库已备份到: ${backupPath}`);

    const backups = fs.readdirSync(backupDir).filter(f => f.endsWith('.db')).sort();
    while (backups.length > 7) {
      const oldest = backups.shift();
      fs.unlinkSync(path.join(backupDir, oldest));
      console.log(`[Backup] 清理旧备份: ${oldest}`);
    }
  } catch (e) {
    console.error('[Backup Error]', e.message);
  }
};

setInterval(performBackup, 6 * 60 * 60 * 1000);
setTimeout(performBackup, 30000);

app.use((err, req, res, next) => {
  console.error('[Server Error]', err.stack);
  res.status(500).json({ error: { message: '服务器内部错误', type: 'internal_error' } });
});
