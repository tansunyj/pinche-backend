# ============================================================
# SiliEvo Relay Server (Express) — 开发环境模板
# ------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 `.env.development`（被 .gitignore 忽略）
#   2. 按本机情况填值
#   3. `npm run dev` 启动 → 自动按 NODE_ENV=development 加载本文件
#
# 加载优先级（高 → 低）：
#   .env.development.local > .env.development > .env.local > .env
# ============================================================

# ---------- 数据库 ----------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD='123456'
DB_NAME=silievo

# ---------- JWT ----------
JWT_SECRET=dev-only-replace-with-a-long-random-secret

# ---------- 服务 ----------
PORT=3001
BODY_LIMIT=50mb

# ---------- Cloudflare Turnstile（留空跳过校验，便于本地开发）----------
TURNSTILE_SECRET_KEY=

# ---------- 对话 / 补全频率限制（按 API Key）----------
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=20
# CHAT_RATE_BLOCK_MS=60000

# ---------- 日志查询接口限流（per-IP）----------
LOGS_RATE_WINDOW_MS=60000
LOGS_RATE_MAX=10
# 连续输入无效 Key 超 LOGS_FAIL_MAX 次将封禁该 IP
LOGS_FAIL_WINDOW_MS=3600000
LOGS_FAIL_MAX=5
