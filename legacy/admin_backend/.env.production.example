# ============================================================
# SiliEvo Relay Server (Express) — 生产环境模板
# ------------------------------------------------------------
# 使用方式：
#   1. 在生产服务器上复制本文件为 `.env.production`
#   2. 按生产实际值填写（数据库、JWT 等绝不能复用开发值）
#   3. `npm start` 启动 → 自动按 NODE_ENV=production 加载本文件
#
# 安全要点：
#   - JWT_SECRET / 数据库密码 / Turnstile Secret 务必使用强随机值，且与 dev 不同
#   - 凭证应通过运维渠道注入，不要进 git
#   - 生产环境不会加载 .env.local
# ============================================================

# ---------- 数据库 ----------
DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=silievo

# ---------- JWT（必须随机 64+ 字符）----------
JWT_SECRET=

# ---------- 服务 ----------
PORT=3001
BODY_LIMIT=50mb

# ---------- 跨域来源（生产建议显式指定，不要用 *）----------
CORS_ORIGIN=https://www.silievo.com

# ---------- Cloudflare Turnstile（生产必填）----------
TURNSTILE_SECRET_KEY=

# ---------- 对话 / 补全频率限制（按 API Key）----------
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=20
# CHAT_RATE_BLOCK_MS=60000

# ---------- 日志查询接口限流（per-IP）----------
LOGS_RATE_WINDOW_MS=60000
LOGS_RATE_MAX=10
LOGS_FAIL_WINDOW_MS=3600000
LOGS_FAIL_MAX=5
