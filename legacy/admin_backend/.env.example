# Silievo Admin Backend 环境变量

# 服务器配置
PORT=3001
NODE_ENV=production
CORS_ORIGIN=*
BODY_LIMIT=10mb

# 数据库配置 (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=silievo_admin

# JWT 配置
JWT_SECRET=your_jwt_secret_here

# 日志级别配置
# 可选值: debug < info < warn < error < silent
# debug: 输出所有日志（包括调试信息）
# info:  输出普通信息及以上级别（默认）
# warn:  仅输出警告和错误
# error: 仅输出错误
# silent: 不输出任何日志
LOG_LEVEL=info

# 可选：仪表盘功能开关
ENABLE_REALTIME_STATS=true

# Redis 配置（用于实时统计）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
